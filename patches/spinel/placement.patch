+static void kiln_sched_hold_active(int wid) {
+  const char *path = getenv("KILN_SCHED_HOLD_ACTIVE");
+  if (!path || path[0] == '\0') return;
+  const char *min_text = getenv("KILN_SCHED_HOLD_MIN_WID");
+  int min_wid = (min_text && min_text[0] != '\0') ? atoi(min_text) : 1;
+  if (wid < min_wid) return;
+  char marker[1024];
+  int wrote = snprintf(marker, sizeof marker, "%s.wid%d", path, wid);
+  if (wrote > 0 && wrote < (int)sizeof marker) {
+    int marker_fd = open(marker, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+    if (marker_fd >= 0) close(marker_fd);
+  }
+  int fd = -1;
+  do { fd = open(path, O_RDONLY); } while (fd < 0 && errno == EINTR);
+  if (fd < 0) return;
+  char byte = 0;
+  for (;;) {
+    ssize_t got = read(fd, &byte, 1);
+    if (got < 0 && errno == EINTR) continue;
+    break;
+  }
+  close(fd);
+}
