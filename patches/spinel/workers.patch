+int sp_sched_application_workers(void) {
+  if (g_workers_started) return g_worker_cap > 0 ? g_worker_cap : 1;
+  int count = kiln_worker_count();
+  if (count) return count;
+  count = sp_worker_count();
+  const char *text = getenv("SPINEL_WORKERS");
+  if (text && *text && count > 1) count--;
+  if (count > SP_MAX_WORKERS - 2) count = SP_MAX_WORKERS - 2;
+  return count;
 }
 
