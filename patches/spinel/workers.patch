 /* min(available CPUs, SPINEL_WORKERS); the env var overrides the autodetect. */
+static int kiln_worker_count(void) {
+  const char *text = getenv("KILN_WORKERS");
+  if (!text || !*text) return 0;
+  char *end = NULL;
+  errno = 0;
+  long count = strtol(text, &end, 10);
+  if (errno || *end || count < 1 || count > SP_MAX_WORKERS - 2) {
+    fprintf(stderr, "kiln: KILN_WORKERS must be an integer from 1 to %d\n", SP_MAX_WORKERS - 2);
+    exit(EXIT_FAILURE);
+  }
+  return (int)count;
+}
