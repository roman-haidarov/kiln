+static int kiln_worker_count(void) {
+  const char *text = getenv("KILN_WORKERS");
+  if (!text || !*text) return 0;
+  char *end = NULL;
+  errno = 0;
+  long count = strtol(text, &end, 10);
+  if (errno || *end || count < 1 || count > SP_MAX_WORKERS - 2) {
+    char message[128];
+    snprintf(message, sizeof message, "KILN_WORKERS must be an integer from 1 to %d", SP_MAX_WORKERS - 2);
+    sp_raise_cls("ArgumentError", message);
+  }
+  return (int)count;
+}
